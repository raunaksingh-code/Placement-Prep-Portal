# Base URL of the deployed API. Leave empty for local development — Vite's dev
# server proxies /api to http://localhost:8000 (see vite.config.ts).
#
# For a production build, set this to your hosted backend, with no trailing slash:
# VITE_API_BASE_URL=https://placement-prep-api.onrender.com
VITE_API_BASE_URL=
